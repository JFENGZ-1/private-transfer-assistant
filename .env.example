# 必填：你的域名必须已解析到服务器。Caddy 会自动申请 HTTPS 证书。
DOMAIN=transfer.example.com
PUBLIC_ORIGIN=https://transfer.example.com
# Compose 中应用端口不对外暴露，且 Caddy 会覆盖转发头，因此可安全信任这一层代理。
# 如果绕过 Caddy 直接暴露应用端口，必须改为 false，并自行处理 HTTPS 与真实 IP。
TRUST_PROXY=true

# 必填：执行 `openssl rand -base64 48` 生成。部署后不要更换，否则现有 Cookie 会失效。
COOKIE_SECRET=replace-with-at-least-32-random-bytes

# 仅首次启动用于初始化，至少 8 位且必须不同。初始化成功后建议从 .env 删除这两行并重启。
MAIN_PASSWORD=replace-with-main-password
ADMIN_PASSWORD=replace-with-admin-password

# 传输与会话
MAX_FILE_SIZE=10737418240
TEMP_SESSION_HOURS=12
DEVICE_DAYS=90
HTTP_PORT=80
HTTPS_PORT=443

# OCR：RapidOCR + ONNX Runtime，默认中英文、单任务、单 CPU 线程。
OCR_ENABLED=true
OCR_POLL_SECONDS=3
OCR_MAX_EDGE=2200
OCR_DET_LIMIT_SIDE=1280
OCR_MAX_IMAGE_PIXELS=40000000
OCR_MIN_SCORE=0.45
OCR_MAX_ATTEMPTS=3
OCR_STALE_AFTER_SECONDS=900
OCR_RELEASE_MODEL_AFTER_SECONDS=300
OCR_CPU_THREADS=1

# 备份工具写入宿主机 ./backups 时使用的 UID/GID。运行 `id -u`、`id -g` 查看。
BACKUP_UID=1000
BACKUP_GID=1000
BACKUP_RETENTION_DAYS=0
